OPENROUTER_API_KEY=your_openrouter_api_key_here
# Signing key for auth tokens. Generate your own — `openssl rand -hex 32`.
# A shared value committed to a repo lets anyone forge a login token.
JWT_SECRET=replace_me_generate_with_openssl_rand_hex_32
# Encryption for the store file the backend writes (messages, addresses).
# Generate your own: openssl rand -hex 32. Unset derives it from JWT_SECRET.
DATA_ENCRYPTION_KEY=replace_me_generate_with_openssl_rand_hex_32
# Where that file lives. Defaults to backend/.data
# DATA_DIR=/var/data/querysphere

BACKEND_PORT=3001
MLEND_PORT=3002
VITE_BACKEND_URL=http://localhost:3001
VITE_MLEND_URL=http://localhost:3002

# --- Deployment (Render / any free-tier host) ---
# Public URL the service pings to stop the host idling it out. On Render this is
# filled in automatically from RENDER_EXTERNAL_URL — only set it elsewhere.
# KEEP_ALIVE_URL=https://querysphere-backend.onrender.com
# Ping cadence in ms. Unset means no pinging (the default for local dev).
KEEP_ALIVE_INTERVAL_MS=300000
# Origins allowed by CORS in production. Comma-separated, no trailing slashes —
# list every hostname the frontend answers on, including the *.vercel.app one.
# FRONTEND_URL=https://querysphere.moeezahmadkhan.com,https://querysphere.vercel.app
