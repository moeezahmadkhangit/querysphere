# OpenRouter key — https://openrouter.ai/keys
# QuerySphere only ever calls `:free` models, so replies cost nothing. An
# account with credits purchased gets 1000 free-model requests/day; a key with
# no credits gets 50/day. Leave this unset and the service still runs, serving
# its local formatter and summarizer instead.
OPENROUTER_API_KEY=your_openrouter_api_key_here
PORT=3002
FRONTEND_URL=http://localhost:5173

# --- Deployment ---
# Public URL this service pings so a free-tier host never idles it out.
# Render fills this in automatically from RENDER_EXTERNAL_URL.
# KEEP_ALIVE_URL=https://querysphere-mlend.onrender.com
# Ping cadence in ms. With no URL resolved the pinger stays off.
KEEP_ALIVE_INTERVAL_MS=300000
